# Used today
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=          # optional locally — omit it and the mock Brand Pack / mock draft paths kick in
GETX_API_KEY=                # optional locally — omit it and the mock tweet-fetch path kicks in
GETX_API_BASE_URL=https://api.getxapi.com   # GetXAPI base URL; key is sent as an Authorization: Bearer token
TOKEN_ENCRYPTION_KEY=        # required — 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
                              # Encrypts the X account auth_token/ct0 pasted in Settings. No mock fallback —
                              # the save-connection route fails loudly if this is missing or malformed.

