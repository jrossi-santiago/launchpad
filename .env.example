# Used today
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # required for the Scheduler. The cron worker posts for a user who is not
                              # signed in, so it is the one place in the app that bypasses RLS.
ANTHROPIC_API_KEY=          # optional locally — omit it and the mock Brand Pack / mock draft paths kick in
GETX_API_KEY=                # optional locally — omit it and the mock tweet-fetch path kicks in
GETX_API_BASE_URL=https://api.getxapi.com   # GetXAPI base URL; key is sent as an Authorization: Bearer token
CRON_SECRET=                 # required for the Scheduler. Vercel Cron sends it as "Authorization: Bearer
                              # <CRON_SECRET>" on every hit to /api/scheduler/run; the route refuses to run
                              # at all when it is unset, since that route sends posts with no session behind
                              # it. Generate with: openssl rand -hex 32
NEXT_PUBLIC_APP_URL=        # your public https:// origin. Needed for the official X OAuth callback
                              # below. Network does not use it — it is poll-only, filling stacks on page
                              # load and on Refresh.
X_CLIENT_ID=                 # official X API OAuth 2.0 client id, from the X developer console.
X_CLIENT_SECRET=             # official X API OAuth 2.0 client secret. Set both (plus NEXT_PUBLIC_APP_URL)
                              # and Settings offers "Connect X account" — replies, likes and follows then
                              # go through the official API instead of session cookies. Unset, Settings
                              # falls back to the legacy cookie paste form.
                              # Register the callback URL in the X app as: <NEXT_PUBLIC_APP_URL>/api/auth/x/callback
                              # Reads (Radar, Network, audience) stay on GetXAPI either way.
X_ENTERPRISE_REPLY_ACCESS=   # optional — set to "true" ONLY with X Enterprise or Public Utility access.
                              # Since 23 Feb 2026 X refuses programmatic replies on every self-serve plan,
                              # so officially connected accounts draft replies and you send them by hand
                              # (Copy -> paste into X -> Mark posted). This flag restores the Post button.
TOKEN_ENCRYPTION_KEY=        # required — 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
                              # Encrypts the stored X credentials — OAuth access/refresh tokens, and the
                              # legacy auth_token/ct0. No mock fallback: the connect routes fail loudly if
                              # this is missing or malformed.

